NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_REF=your-project-ref
# 서버 배포 환경에만 설정합니다. 브라우저 번들·Git에는 실제 값을 넣지 않습니다.
SUPABASE_SERVICE_ROLE_KEY=
# 원격 통합 테스트에서 임시 사용자 생성과 정리에만 사용합니다.
# Supabase secret key를 비밀 저장소에서 SOHEE_INTEGRATION_ADMIN_SECRET_KEY로 주입합니다.
SOHEE_INTEGRATION_ADMIN_SECRET_KEY=
APP_URL=http://localhost:3000

# OpenAI 키는 서버 런타임 비밀값으로만 설정합니다.
OPENAI_TEXT_API_KEY=
OPENAI_IMAGE_API_KEY=
OPENAI_TEXT_MODEL=gpt-5.6-luna
OPENAI_TEXT_REASONING_EFFORT=high
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst

# Meta 비밀값은 로컬 비밀 파일 또는 Cloudflare Worker secret으로만 주입합니다.
# 채널별 OAuth 토큰은 이 파일에 두지 않고 AES-GCM 암호화 후 서버 전용 DB에 저장합니다.
META_APP_SECRET=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
THREADS_APP_ID=
THREADS_APP_SECRET=
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=
THREADS_WEBHOOK_VERIFY_TOKEN=
CRON_SECRET=
META_CHANNEL_CREDENTIALS_ENCRYPTION_KEY=
META_OAUTH_STATE_ENCRYPTION_KEY=

# Linear Done 자동 아카이브: 1분마다 스캔하고 완료 후 15분이 지나면 Archive합니다.
# 실제 API key는 Git에 커밋하지 않고 Cloudflare Worker Secret으로만 주입합니다.
LINEAR_API_KEY=
# 기본값은 Ani 팀 UUID이며, 다른 팀에서 재사용할 때만 덮어씁니다.
LINEAR_TEAM_ID=

# Kakao 로그인 및 비즈메시지 연동
# JavaScript 키 (클라이언트 SDK 초기화용)
KAKAO_JS_KEY=
# REST API 키 (서버 토큰 발급 및 카카오 API 호출용 - 비밀값)
KAKAO_REST_API_KEY=
# Client Secret (카카오 로그인 보안 강화용 - 비밀값)
KAKAO_CLIENT_SECRET=
# OAuth State HMAC 서명 비밀키 (CSRF 방어용 - 비밀값, clientSecret 재사용 금지)
KAKAO_STATE_SECRET=
# 카카오 사용자 연결끊기(unlink) 웹훅 검증 Admin 키 (Authorization: KakaoAK ${KAKAO_WEBHOOK_SECRET} - 비밀값)
KAKAO_WEBHOOK_SECRET=
# 카카오 로그인 허용 출처 (콤마 구분)
KAKAO_ALLOWED_ORIGINS=https://example.com,https://m.example.com
# 카카오 OAuth Redirect URI 목록 (콤마 구분)
KAKAO_REDIRECT_URIS=https://example.com/api/auth/kakao/callback,https://m.example.com/api/auth/kakao/callback
# 클라이언트 로그인 폼 표시/기능 활성화 플래그 (선택)
NEXT_PUBLIC_KAKAO_JS_KEY=
NEXT_PUBLIC_KAKAO_ENABLED=false

# 솔라피 (Solapi) 알림톡 발송 대행사 연동 (KAPI-11)
# 솔라피 API Key (비밀값)
SOLAPI_API_KEY=
# 솔라피 API Secret (HMAC-SHA256 서명용 - 비밀값)
SOLAPI_API_SECRET=
# 솔라피 카카오 알림톡 발신프로필 ID (선택/기본 발신프로필)
SOLAPI_PF_ID=
# 솔라피 알림톡 실발송 활성화 여부 (true: 실발송, false: DRY_RUN 모의발송)
SOLAPI_ENABLED=false
