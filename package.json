{
  "name": "sohee-clone-mvp",
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "node scripts/local-public-env.mjs",
    "write-build-meta": "node scripts/write-build-meta.mjs",
    "prebuild": "node scripts/write-build-meta.mjs",
    "build": "next build",
    "build:cloudflare": "node scripts/cloudflare-build.mjs",
    "preview:cloudflare": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy:cloudflare": "node scripts/deploy-cloudflare-production.mjs",
    "dev:keychain": "bash scripts/run-with-openai-keychain.sh npm run dev",
    "secrets:openai:keychain": "bash scripts/setup-openai-keychain.sh",
    "secrets:openai:cloudflare": "bash scripts/sync-openai-cloudflare-secrets.sh",
    "start": "next start",
    "typecheck": "node --max-old-space-size=6144 node_modules/typescript/bin/tsc --noEmit",
    "lint": "eslint .",
    "lint:user-copy": "node scripts/lint-user-copy/index.mjs",
    "lint:user-copy:rendered": "node scripts/lint-user-copy/scan-rendered.mjs",
    "verify:truth": "node scripts/verify-runtime-truth.mjs",
    "verify:schema-drift": "node scripts/verify-schema-code-drift.mjs",
    "gen:db-types": "node scripts/gen-db-types.mjs",
    "verify:secret": "node scripts/verify-secret-exposure.mjs",
    "verify:release-truth": "node scripts/verify-release-truth.mjs",
    "verify:control-plane": "node scripts/verify-control-plane.mjs",
    "db:verify-drift": "node scripts/verify-migration-drift.mjs",
    "verify:provider-evidence": "node scripts/verify-provider-evidence-gate.mjs",
    "verify:deps": "depcruise --config .dependency-cruiser.cjs src",
    "verify:architecture": "npm run verify:deps",
    "verify:wave": "node scripts/run-wave-gate.mjs",
    "test": "vitest run",
    "test:changed": "vitest related --run",
    "test:fast": "vitest related --run",
    "test:watch": "vitest",
    "test:integration": "node scripts/run-integration-tests.mjs",
    "test:vault-db": "node scripts/test-vault-db.mjs",
    "test:tenant-isolation": "node scripts/test-vault-db.mjs --tenant-isolation",
    "test:tenant-security-db": "node scripts/test-tenant-security-db.mjs",
    "test:marketing-connectors-db": "node scripts/test-marketing-connectors-db.mjs",
    "test:local-publish-dispatch": "node scripts/test-vault-db.mjs --local-publish-dispatch",
    "test:naver-post-jobs": "node scripts/test-vault-db.mjs --naver-post-jobs",
    "test:naver-categories": "node scripts/test-vault-db.mjs --naver-categories",
    "test:booking-recovery-db": "node scripts/test-vault-db.mjs --booking-recovery",
    "test:email-signup-db": "node scripts/test-vault-db.mjs --email-signup",
    "test:connector-control": "vitest run src/features/local-publishing src/features/external-actions && playwright test tests/e2e/connector-settings.spec.ts",
    "connector:setup": "node scripts/connector-setup.mjs",
    "connector:build": "node connector/chrome-extension/scripts/build.mjs",
    "connector:native:build": "node connector/native-host/scripts/build.mjs",
    "connector:native:install": "npm run connector:native:build && node connector/native-host/scripts/install.mjs",
    "connector:build:test": "node connector/chrome-extension/scripts/build.mjs --test",
    "connector:test": "vitest run connector/chrome-extension && npm run connector:build:test && playwright test --config playwright.connector.config.ts",
    "verify:local-publish": "npm run test:connector-control && npm run connector:test && npm run connector:build && npm run typecheck && npm run lint && npm run build && npm run build:cloudflare && node scripts/verify-local-publish-release.mjs",
    "test:openai:live": "SOHEE_OPENAI_LIVE=1 vitest run --config vitest.openai-live.config.ts",
    "test:e2e:live": "playwright test --config playwright.live.config.ts tests/e2e/live-auth.spec.ts tests/e2e/live-chat.spec.ts tests/e2e/live-report.spec.ts",
    "test:e2e:admin-live": "playwright test --config playwright.live.config.ts tests/e2e/admin-live-smoke.spec.ts",
    "test:e2e": "PLAYWRIGHT_BROWSERS_PATH=0 playwright install chromium && PLAYWRIGHT_BROWSERS_PATH=0 playwright test",
    "test:e2e:mobile-r2": "playwright test --config playwright.mobile-r2.config.ts",
    "test:e2e:mobile-r2:selftest": "playwright test --config playwright.mobile-r2.config.ts tests/e2e/mobile-r2/harness-selftest.mobile.spec.ts --project=ios-390 --project=android-390",
    "a11y:mobile-r2:sweep": "node scripts/run-mobile-a11y-sweep.mjs",
    "mobile-r2:baseline:update": "playwright test --config playwright.mobile-r2.config.ts tests/e2e/mobile-r2/desktop-baseline.desktop.spec.ts --project=tablet-768 --project=tablet-820 --project=desktop-1024 --project=desktop-1280 --project=desktop-1440 --update-snapshots",
    "e2e:channel-studio": "node scripts/e2e/channel-studio-measure.mjs",
    "e2e:chat-reliability": "vite-node -c vitest.config.ts scripts/e2e/chat-reliability-measure.ts"
  },
  "dependencies": {
    "@number-flow/react": "^0.6.2",
    "@portone/browser-sdk": "0.1.13",
    "@portone/server-sdk": "0.19.0",
    "@radix-ui/react-slot": "^1.3.3",
    "@supabase/ssr": "0.12.0",
    "@supabase/supabase-js": "2.109.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-query": "5.90.5",
    "@tanstack/react-table": "^9.1.2",
    "@tanstack/react-virtual": "^3.14.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "heic-to": "1.6.7",
    "ical.js": "2.2.1",
    "lucide-react": "1.30.0",
    "motion": "^13.1.1",
    "next": "16.4.1",
    "next-themes": "^0.4.6",
    "nuqs": "^2.10.0",
    "openai": "7.4.0",
    "postcss": "^8.5.26",
    "radix-ui": "^1.7.0",
    "react": "19.2.8",
    "react-aria-components": "^1.20.0",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.86.0",
    "recharts": "^3.10.1",
    "server-only": "0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@opennextjs/cloudflare": "1.20.2",
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/chrome": "0.2.6",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "4.4.1",
    "dependency-cruiser": "18.2.0",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.1",
    "jsdom": "26.1.0",
    "knip": "6.34.0",
    "msw": "2.15.0",
    "supabase": "2.113.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.0",
    "vite": "6.4.5",
    "vite-node": "3.2.4",
    "vitest": "4.1.12",
    "wrangler": "4.156.2"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
